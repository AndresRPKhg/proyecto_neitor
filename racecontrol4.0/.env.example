# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.
APP_ENV=local            # local | production
APP_URL=http://localhost/racecontrol/public
APP_TIMEZONE=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=racecontrol
DB_USER=root
DB_PASS=

# Correo para recuperación de contraseña. "log" escribe el correo en storage/logs/correos.log (ideal para XAMPP).
MAIL_DRIVER=log          # log | mail
MAIL_FROM=no-reply@racecontrol.local
